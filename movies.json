// Yeh function saari movies ko aik aik kar ke safe tareeqay se render karega
async function renderAllMovies() {
  const container = document.getElementById("movies-container");
  if (!container) return;

  container.innerHTML = "";

  for (const movie of moviesData) {
    const posterUrl = await fetchPoster(movie.tmdb_id);
    
    const card = document.createElement("div");
    card.className = "bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-lg flex flex-col";
    
    card.innerHTML = `
      <img src="${posterUrl || 'https://via.placeholder.com/500x750/1e293b/f8fafc?text=No+Poster'}" alt="${movie.title}" class="w-full h-80 object-cover" />
      <div class="p-4 flex flex-col flex-grow">
        <h3 class="text-lg font-bold text-white mb-1">${movie.title} (${movie.release_year})</h3>
        <p class="text-sm text-slate-400 mb-4 line-clamp-2">${movie.synopsis}</p>
        <a href="movie.html?slug=${movie.slug}" class="mt-auto bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold py-2 px-4 rounded-lg text-center transition">View Streaming Options</a>
      </div>
    `;
    
    container.appendChild(card);
  }
}

// Function ko call kar dein
renderAllMovies();
