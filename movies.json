async function loadMovies() {
  try {
    // Relative path ki jagah yeh try karein
    const response = await fetch('./movies.json');
    
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }
    
    const movies = await response.json();
    console.log("Loaded movies successfully:", movies);
    
    if (Array.isArray(movies) && movies.length > 0) {
      renderMovies(movies);
    } else {
      console.error("JSON data khali hai ya array nahi hai!");
    }
  } catch (error) {
    console.error("movies.json load karne mein error aa gaya:", error);
  }
}

// Call function
loadMovies();
